<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_splash">

    <fragment
        android:id="@+id/navigation_splash"
        android:name="com.crodrigo.cavosh.ui.splash.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_navigation_splash_to_login"
            app:destination="@id/navigation_login" />
    </fragment>
    <fragment
        android:id="@+id/navigation_login"
        android:name="com.crodrigo.cavosh.ui.auth.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_navigation_login_to_navigation_registrar"
            app:destination="@id/navigation_registrar" />
        <action
            android:id="@+id/action_navigation_login_to_navigation_inicio"
            app:destination="@id/navigation_inicio" />
    </fragment>
    <fragment
        android:id="@+id/navigation_registrar"
        android:name="com.crodrigo.cavosh.ui.auth.RegistrarFragment"
        android:label="fragment_registrar"
        tools:layout="@layout/fragment_registrar" >
        <action
            android:id="@+id/action_navigation_registrar_to_verificar"
            app:destination="@id/navigation_verificar" />
    </fragment>
    <fragment
        android:id="@+id/navigation_verificar"
        android:name="com.crodrigo.cavosh.ui.auth.VerificarFragment"
        android:label="fragment_verificar"
        tools:layout="@layout/fragment_verificar" />
    <fragment
        android:id="@+id/navigation_inicio"
        android:name="com.crodrigo.cavosh.ui.inicio.InicioFragment"
        android:label="fragment_inicio"
        tools:layout="@layout/fragment_inicio" >
        <action
            android:id="@+id/action_navigation_inicio_to_navigation_menu"
            app:destination="@id/navigation_menu" />
        <action
            android:id="@+id/action_navigation_inicio_to_navigation_perfil"
            app:destination="@id/navigation_perfil" />
        <action
            android:id="@+id/action_navigation_inicio_to_navigation_carrito"
            app:destination="@id/navigation_carrito" />
        <action
            android:id="@+id/action_navigation_inicio_to_navigation_favoritos"
            app:destination="@id/navigation_favoritos" />
    </fragment>
    <fragment
        android:id="@+id/navigation_menu"
        android:name="com.crodrigo.cavosh.ui.menu.MenuFragment"
        android:label="fragment_menu"
        tools:layout="@layout/fragment_menu" />
    <fragment
        android:id="@+id/navigation_perfil"
        android:name="com.crodrigo.cavosh.ui.perfil.PerfilFragment"
        android:label="fragment_perfil"
        tools:layout="@layout/fragment_perfil" />
    <fragment
        android:id="@+id/navigation_carrito"
        android:name="com.crodrigo.cavosh.ui.carrito.CarritoFragment"
        android:label="fragment_carrito"
        tools:layout="@layout/fragment_carrito" />
    <fragment
        android:id="@+id/navigation_favoritos"
        android:name="com.crodrigo.cavosh.ui.favoritos.FavoritosFragment"
        android:label="fragment_favoritos"
        tools:layout="@layout/fragment_favoritos" />
</navigation>